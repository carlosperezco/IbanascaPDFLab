// Icono y datos de versión del .exe. Generado por CMake: no editar el .rc resultante.
#include <winver.h>

IDI_ICON1 ICON "@IBZ_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DonatellaTech"
            VALUE "FileDescription", "Ibanasca PDF Lab"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ibanascapdf"
            VALUE "LegalCopyright", "Copyright (c) 2026 Carlos N. Perez-Montenegro (DonatellaTech)"
            VALUE "OriginalFilename", "ibanascapdf.exe"
            VALUE "ProductName", "Ibanasca PDF Lab"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
